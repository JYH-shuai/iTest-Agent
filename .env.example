# iTest-Agent 环境变量示例

# LLM 配置（配置后走真实 LLM；留空自动降级为规则解析）
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 规则解析降级：1 表示不使用 LLM
ITEST_MOCK_LLM=0

# 执行模式：mcp（真实 MCP 工具） / simulated（模拟）
ITEST_EXECUTION_MODE=simulated

# 接口测试默认 Base URL
ITEST_API_BASE_URL=

# 知识库与输出目录
ITEST_KB_DIR=./chroma_db
ITEST_OUTPUT_ROOT=./output

# API 端口
ITEST_API_PORT=8000
